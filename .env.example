# Placeholders only. Do not use production credentials here.
# No .env is required for offline checks. Set DATABASE_URL only for approved local DB use.
DATABASE_URL=postgresql://notary_dev:replace-with-local-password@127.0.0.1:5432/notary_dev
# Compose DB is private; the app's Compose URL uses host "db" instead.
POSTGRES_USER=notary_dev
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=notary_dev
NEXT_TELEMETRY_DISABLED=1

# Keep false for development/staging. Production requires an explicit launch decision.
SITE_INDEXING_ENABLED=false
